# Raw crawl output is upstream content, not committed.
# vi/ (translated output) IS committed — it's the work product and the docs-site
# CI pipeline reads from it.
output/*/raw/
output/*/site/
output/**/*.tmp-input.md
output/**/*.tmp-output.md
output/**/*.blocks.json

# docs-site build artefacts (regenerated by CI / sync_projects.py)
docs-site/site/
docs-site/docs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Project
spike_a_temp/
*.tmp

.claude/settings.local.json
